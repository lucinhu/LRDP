# Adapt the pinned plugin to Flutter's current MethodResult API in a build
# copy. Pub cache/upstream sources remain untouched on every host toolchain.
function(lrdp_dynamic_color_windows_compat)
  if(NOT TARGET dynamic_color_plugin)
    return()
  endif()
  get_target_property(source_dir dynamic_color_plugin SOURCE_DIR)
  set(original "${source_dir}/dynamic_color_plugin.cpp")
  file(READ "${original}" content)
  string(FIND "${content}" "result->Success(nullptr);" old_call)
  if(old_call EQUAL -1)
    return()
  endif()
  file(SHA256 "${original}" digest)
  if(NOT digest STREQUAL "f53b205e8d91def50757eddbe9397f0addf10ae7fbc511c2347bd45cfb8dc13e")
    message(FATAL_ERROR "Review the dynamic_color Windows compatibility adapter for this dependency version")
  endif()
  string(REPLACE "result->Success(nullptr);" "result->Success();" content "${content}")
  set(adapted "${CMAKE_CURRENT_BINARY_DIR}/lrdp-compat/dynamic_color_plugin.cpp")
  file(MAKE_DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/lrdp-compat")
  set(previous "")
  if(EXISTS "${adapted}")
    file(READ "${adapted}" previous)
  endif()
  if(NOT previous STREQUAL content)
    file(WRITE "${adapted}" "${content}")
  endif()
  get_target_property(sources dynamic_color_plugin SOURCES)
  set(adapted_sources "")
  foreach(source IN LISTS sources)
    get_filename_component(name "${source}" NAME)
    if(name STREQUAL "dynamic_color_plugin.cpp")
      list(APPEND adapted_sources "${adapted}")
    elseif(IS_ABSOLUTE "${source}")
      list(APPEND adapted_sources "${source}")
    else()
      list(APPEND adapted_sources "${source_dir}/${source}")
    endif()
  endforeach()
  set_property(TARGET dynamic_color_plugin PROPERTY SOURCES "${adapted_sources}")
  target_include_directories(dynamic_color_plugin PRIVATE "${source_dir}")
endfunction()
