FROM docker.io/library/ubuntu@sha256:0a9887931b0e38af2e3487ed39e29436b0535c4f3f52e57745baaf79d1898956

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates clang cmake curl desktop-file-utils dpkg-dev file git \
    gobject-introspection libgirepository1.0-dev libgtk-3-dev libepoxy-dev \
    liblzma-dev libssl-dev libsecret-1-dev libpulse-dev librsvg2-dev \
    libfuse2 libegl1-mesa libgl1-mesa-dri libglu1-mesa \
    ibus-gtk3 fcitx5-frontend-gtk3 fonts-noto-cjk \
    make nasm ninja-build patchelf pkg-config python3 unzip xz-utils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /project
